{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rio",
  "main": "server/index.ts",
  "account_id": "d51a8fde361e4be31db17d8c56737c1f",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rio.hexly.ai", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://rio.hexly.ai",
    "ACCESS_TEAM": "nocoo",
    "ACCESS_AUD": "163761e9258c70919bb5f4044e5408152f7985e7eb08e2d39e6905bd9a0c8b29",
    "APP_VERSION": "0.1.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rio",
      "database_id": "065e4bc6-f491-4c1d-aac0-faba31ef70b6",
      "migrations_dir": "migrations"
    }
  ],
  "version_metadata": { "binding": "VERSION" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "dev": { "ip": "127.0.0.1", "port": 7054, "inspector_port": 37054 }
}
